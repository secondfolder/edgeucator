{
	"name": "edgeucator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:worker": "npm run build && npm run db:migrate:d1 && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:d1": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:reset": "rm -f local.db local.db-shm local.db-wal && npm run db:migrate && npm run db:seed",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config ./better-auth.config.ts --adapter drizzle --dialect sqlite --output src/lib/server/db/schema/auth.ts --yes",
		"auth:secret": "auth secret",
		"cf-typegen": "wrangler types ./src/worker-env.d.ts --include-runtime=false"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260903.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@libsql/client": "^0.18.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@types/node": "^22.20.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tsx": "^4.23.13",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0",
		"wrangler": "^4.128.0"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.2",
		"better-auth": "^1.7.2",
		"drizzle-orm": "^0.45.2",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.5.4"
	},
	"engines": {
		"node": ">=20"
	}
}
