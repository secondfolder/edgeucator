{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bound-up",
	"main": "worker.ts",
	"compatibility_date": "2026-09-01",
	// Required twice over: kit's getRequestEvent does import('node:async_hooks'),
	// and @better-auth/core/async_hooks does the same. `nodejs_als` is the minimum
	// that would work; `nodejs_compat` is a superset and also populates
	// process.env, which stops better-auth's env probing from coming up empty.
	"compatibility_flags": ["nodejs_compat"],
	// `src/routes/+layout.svelte` statically imports the Web Awesome
	// registrations so hydration does not have to fetch them after load. That
	// puts Lit in the server graph too, and workerd has no `HTMLElement`, so
	// wrangler's esbuild pass must swap the two bare Lit entrypoints to their
	// packaged node shims.
	"alias": {
		"@lit/reactive-element": "./node_modules/@lit/reactive-element/node/reactive-element.js",
		"@lit/reactive-element/css-tag.js": "./node_modules/@lit/reactive-element/node/css-tag.js",
		"@lit/reactive-element/reactive-element.js": "./node_modules/@lit/reactive-element/node/reactive-element.js",
		"@lit/reactive-element/decorators.js": "./node_modules/@lit/reactive-element/node/decorators.js",
		"@lit/reactive-element/decorators/base.js": "./node_modules/@lit/reactive-element/node/decorators/base.js",
		"@lit/reactive-element/decorators/custom-element.js": "./node_modules/@lit/reactive-element/node/decorators/custom-element.js",
		"@lit/reactive-element/decorators/event-options.js": "./node_modules/@lit/reactive-element/node/decorators/event-options.js",
		"@lit/reactive-element/decorators/property.js": "./node_modules/@lit/reactive-element/node/decorators/property.js",
		"@lit/reactive-element/decorators/query.js": "./node_modules/@lit/reactive-element/node/decorators/query.js",
		"@lit/reactive-element/decorators/query-all.js": "./node_modules/@lit/reactive-element/node/decorators/query-all.js",
		"@lit/reactive-element/decorators/query-async.js": "./node_modules/@lit/reactive-element/node/decorators/query-async.js",
		"@lit/reactive-element/decorators/query-assigned-elements.js": "./node_modules/@lit/reactive-element/node/decorators/query-assigned-elements.js",
		"@lit/reactive-element/decorators/query-assigned-nodes.js": "./node_modules/@lit/reactive-element/node/decorators/query-assigned-nodes.js",
		"@lit/reactive-element/decorators/state.js": "./node_modules/@lit/reactive-element/node/decorators/state.js",
		"@lit/reactive-element/polyfill-support.js": "./node_modules/@lit/reactive-element/node/polyfill-support.js",
		"@lit/reactive-element/reactive-controller.js": "./node_modules/@lit/reactive-element/node/reactive-controller.js",
		"lit-html": "./node_modules/lit-html/node/lit-html.js",
		"lit-html/async-directive.js": "./node_modules/lit-html/node/async-directive.js",
		"lit-html/directive-helpers.js": "./node_modules/lit-html/node/directive-helpers.js",
		"lit-html/directive.js": "./node_modules/lit-html/node/directive.js",
		"lit-html/directives/async-append.js": "./node_modules/lit-html/node/directives/async-append.js",
		"lit-html/directives/async-replace.js": "./node_modules/lit-html/node/directives/async-replace.js",
		"lit-html/directives/cache.js": "./node_modules/lit-html/node/directives/cache.js",
		"lit-html/directives/choose.js": "./node_modules/lit-html/node/directives/choose.js",
		"lit-html/directives/class-map.js": "./node_modules/lit-html/node/directives/class-map.js",
		"lit-html/directives/guard.js": "./node_modules/lit-html/node/directives/guard.js",
		"lit-html/directives/if-defined.js": "./node_modules/lit-html/node/directives/if-defined.js",
		"lit-html/directives/join.js": "./node_modules/lit-html/node/directives/join.js",
		"lit-html/directives/keyed.js": "./node_modules/lit-html/node/directives/keyed.js",
		"lit-html/directives/live.js": "./node_modules/lit-html/node/directives/live.js",
		"lit-html/directives/map.js": "./node_modules/lit-html/node/directives/map.js",
		"lit-html/directives/range.js": "./node_modules/lit-html/node/directives/range.js",
		"lit-html/directives/ref.js": "./node_modules/lit-html/node/directives/ref.js",
		"lit-html/directives/repeat.js": "./node_modules/lit-html/node/directives/repeat.js",
		"lit-html/directives/style-map.js": "./node_modules/lit-html/node/directives/style-map.js",
		"lit-html/directives/template-content.js": "./node_modules/lit-html/node/directives/template-content.js",
		"lit-html/directives/unsafe-html.js": "./node_modules/lit-html/node/directives/unsafe-html.js",
		"lit-html/directives/unsafe-mathml.js": "./node_modules/lit-html/node/directives/unsafe-mathml.js",
		"lit-html/directives/unsafe-svg.js": "./node_modules/lit-html/node/directives/unsafe-svg.js",
		"lit-html/directives/until.js": "./node_modules/lit-html/node/directives/until.js",
		"lit-html/directives/when.js": "./node_modules/lit-html/node/directives/when.js",
		"lit-html/is-server.js": "./node_modules/lit-html/node/is-server.js",
		"lit-html/lit-html.js": "./node_modules/lit-html/node/lit-html.js",
		"lit-html/polyfill-support.js": "./node_modules/lit-html/node/polyfill-support.js",
		"lit-html/static.js": "./node_modules/lit-html/node/static.js"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// Encrypted message attachments. Create it with
			// `npx wrangler r2 bucket create bound-up-media`.
			// `npm run dev` never reads this: with no platform there is no R2
			// binding at all, and src/lib/server/media/dev.ts writes to
			// ./local-media instead.
			"bucket_name": "bound-up-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				// One object per partnership, holding only the open SSE connections
				// watching it. No storage, and it never sees message content.
				"class_name": "RealtimeRoom"
			}
		]
	},
	// NOTHING to do with `d1_databases[0].migrations_dir` below, despite the
	// shared word. That one is SQL applied by `npm run db:migrate:d1`; this is
	// the Durable Object *class* lifecycle, which wrangler applies itself on
	// deploy and which no db script touches.
	//
	// `new_sqlite_classes`, not `new_classes`: SQLite-backed Durable Objects are
	// the only kind available on the Workers Free plan. This class stores
	// nothing either way, so the backend is a billing decision rather than a
	// technical one.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RealtimeRoom"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bound-up",
			// Replace with the id from `npx wrangler d1 create bound-up`.
			// Only needed for `npm run preview:worker` and `npm run deploy` —
			// `npm run dev` uses ./local.db and never reads this file.
			"database_id": "eb783b31-d64c-4582-b386-d43c3d59ac67",
			// drizzle-kit's `out`. Applied with `wrangler d1 migrations apply`;
			// the local ./local.db is applied with `drizzle-kit migrate` instead.
			"migrations_dir": "drizzle"
		}
	]
}
