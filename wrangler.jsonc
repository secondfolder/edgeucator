{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edgeucator",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	// Required twice over: kit's getRequestEvent does import('node:async_hooks'),
	// and @better-auth/core/async_hooks does the same. `nodejs_als` is the minimum
	// that would work; `nodejs_compat` is a superset and also populates
	// process.env, which stops better-auth's env probing from coming up empty.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// Encrypted message attachments. Create it with
			// `npx wrangler r2 bucket create edgeucator-media`.
			// `npm run dev` never reads this: with no platform there is no R2
			// binding at all, and src/lib/server/media/dev.ts writes to
			// ./local-media instead.
			"bucket_name": "edgeucator-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				// One object per partnership, holding only the open SSE connections
				// watching it. No storage, and it never sees message content.
				"class_name": "RealtimeRoom"
			}
		]
	},
	// NOTHING to do with `d1_databases[0].migrations_dir` below, despite the
	// shared word. That one is SQL applied by `npm run db:migrate:d1`; this is
	// the Durable Object *class* lifecycle, which wrangler applies itself on
	// deploy and which no db script touches.
	//
	// `new_sqlite_classes`, not `new_classes`: SQLite-backed Durable Objects are
	// the only kind available on the Workers Free plan. This class stores
	// nothing either way, so the backend is a billing decision rather than a
	// technical one.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RealtimeRoom"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edgeucator",
			// Replace with the id from `npx wrangler d1 create edgeucator`.
			// Only needed for `npm run preview:worker` and `npm run deploy` —
			// `npm run dev` uses ./local.db and never reads this file.
			"database_id": "REPLACE_ME",
			// drizzle-kit's `out`. Applied with `wrangler d1 migrations apply`;
			// the local ./local.db is applied with `drizzle-kit migrate` instead.
			"migrations_dir": "drizzle"
		}
	]
}
